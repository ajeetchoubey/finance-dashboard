PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_dashboard
# For Neon DB (production): set DATABASE_URL to the pooled connection string
# and DIRECT_URL to the non-pooled (direct) connection string for migrations.
DIRECT_URL=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
# Comma-separated allowed origins, or * to allow all (default)
CORS_ORIGIN=*
